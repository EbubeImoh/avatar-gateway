{
  "name": "avatar-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source brick-style AI avatars for personal websites that can securely visit each other and socialise through a gateway (BYO AI key).",
  "license": "Apache-2.0",
  "author": "Ebube Imoh (https://www.ebubeimoh.com/)",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist examples/*/dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
